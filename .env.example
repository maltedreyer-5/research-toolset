# research-toolset — example configuration
# Copy to .env and adjust. Never commit the .env file (it is in .gitignore).
# Only the LLM endpoint is required; everything else is optional.

# ── LLM (OpenAI-compatible endpoint) — REQUIRED ─────────────────────
LLM_API_BASE=http://localhost:8000/v1
LLM_API_KEY=change-me
LLM_MODEL_NAME=your-model
# LLM_MAX_CONTEXT_TOKENS=260000   # set to your model's context size
# LLM_MAX_OUTPUT_TOKENS=32768
# LLM_DEFAULT_TEMPERATURE=0.3
# LLM_TIMEOUT=120
# LLM_ENABLE_THINKING=true    # thinking mode of the primary model (Qwen-style chat_template_kwargs)
# LLM_DEFAULT_TOP_P=0.6

# Optional second, faster model for extraction and classifiers
# (defaults to the primary model)
# HARVEST_LLM_API_BASE=
# HARVEST_LLM_API_KEY=
# HARVEST_LLM_MODEL_NAME=
# HARVEST_MAX_PARALLEL=
# HARVEST_LLM_MAX_CONTEXT_TOKENS=32000
# HARVEST_LLM_MAX_OUTPUT_TOKENS=4096
# HARVEST_LLM_DEFAULT_TEMPERATURE=0.2
# HARVEST_LLM_TIMEOUT=90

# ── Web search (SearXNG) ────────────────────────────────────────────
SEARXNG_BASE_URL=http://searxng:8080
# SEARXNG_TIMEOUT=30
# SEARXNG_MAX_RESULTS=10

# ── Server ──────────────────────────────────────────────────────────
# Bind address: 127.0.0.1 by default; the Docker image sets 0.0.0.0.
# GRADIO_SERVER_NAME=127.0.0.1
# GRADIO_SERVER_PORT=7860
# Path prefix when served behind a reverse proxy under a sub-path, e.g. /research
# ROOT_PATH=
# Optional basic login
# SERVER_AUTH_USER=
# SERVER_AUTH_PASSWORD=
# Optional TLS directly in the app (otherwise terminate TLS at a reverse proxy)
# SERVER_SSL_CERTFILE=
# SERVER_SSL_KEYFILE=
# SERVER_SSL_PASSWORD=
# Outgoing TLS is always verified. For internal services with an internal CA,
# point SSL_CERT_FILE to the CA bundle. TLS_VERIFY=false switches verification
# off only for embedder, reranker, person directory and Solr.
# TLS_VERIFY=true
# SSL_CERT_FILE=

# ── Output language of reports ──────────────────────────────────────
# OUTPUT_LANGUAGES=en,de
# DEFAULT_OUTPUT_LANGUAGE=en
# OUTPUT_CATALOG_DIR=

# ── Research pipeline ───────────────────────────────────────────────
# MAX_RESEARCH_ROUNDS=5
# MAX_SOURCES_PER_ROUND=20
# MAX_PARALLEL_FETCHES=10
# MAX_WEB_SEARCHES=40
# FETCH_TIMEOUT=30
# Internal hosts that may be fetched despite the SSRF protection (comma-separated)
# FETCH_ALLOWED_INTERNAL_HOSTS=
# Reranker / embedder (optional, improve source selection)
# RERANKER_BASE_URL=
# RERANKER_MODEL=
# RERANKER_API_KEY=
# EMBEDDER_BASE_URL=
# EMBEDDER_MODEL=
# EMBEDDER_API_KEY=

# ── Data and retention ──────────────────────────────────────────────
# DATA_DIR=data/runs
# Stored runs older than this are deleted (checked at start-up and every 6 h)
# CLEANUP_MAX_AGE_DAYS=30
# APP_TEMP_DIR=
# PDF_STRATEGY=fast
# USE_PLAYWRIGHT=false

# ── Optional sources ────────────────────────────────────────────────
# GITHUB_ENABLED=true
# GITHUB_TOKEN=
# GITLAB_BASE_URL=
# GITLAB_TOKEN=
# S2_API_KEY=
# CONTACT_EMAIL=            # used in the User-Agent for polite API use
# Elasticsearch index of your own website
# ELASTIC_BASE_URL=
# ELASTIC_INDEX=
# ELASTIC_API_KEY=
# ELASTIC_USERNAME=
# ELASTIC_PASSWORD=
# ELASTIC_FIELD_TITLE=title
# ELASTIC_FIELD_BODY=body
# ELASTIC_FIELD_URL=url
# ELASTIC_FIELD_PATH=
# ELASTIC_SITE_BASE_URL=
# ELASTIC_MAX_RESULTS=10

# ── Institution mode (optional) ─────────────────────────────────────
# INSTITUTION_PROFILE=/path/to/institution.toml   (see examples/institution.example.toml)
# MAX_WEB_SEARCHES_INSTITUTION=60
# PERSON_DIRECTORY_DB=/path/to/directory.sqlite   (see examples/person_directory/)
# SOLR_SCHEME=https
# SOLR_HOST=
# SOLR_PORT=
# SOLR_CORE_DE=
# SOLR_CORE_EN=
# SOLR_USERNAME=
# SOLR_PASSWORD=
# TOOL_PUBLIC_URL=

# ── Advanced tuning ─────────────────────────────────────────────────
# Thinking mode for the harvest model (Qwen-style chat_template_kwargs)
# HARVEST_LLM_ENABLE_THINKING=false
# Similarity above which two extracts count as duplicates (with an embedder)
# EXTRACT_DEDUP_THRESHOLD=0.93
# Rate limits per external API: "requests_per_second" or "parallel,min_delay"
# Names: CROSSREF, OPENALEX, S2, DBLP, ARXIV, URL_CHECK, WEB_FETCH, SEARXNG
# RATELIMIT_OPENALEX=8,0.12
# RATELIMIT_ARXIV=1,3.0
# Minimum delay in seconds between two fetches from the same domain
# RATELIMIT_WEBFETCH_PER_DOMAIN=0.5
